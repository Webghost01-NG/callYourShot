# Public DreamDEX venue identity. Obtain these from the event organizer.
VITE_DREAMDEX_OPERATOR_ID=
VITE_DREAMDEX_VENUE_ID=

# Optional public preference. Values must identify the same official Shannon
# endpoint bundle; the other official bundle remains the failover route.
VITE_DREAMDEX_INDEXER_URL=
VITE_SOMNIA_HTTP_RPC_URL=
VITE_SOMNIA_WS_RPC_URL=

# Optional public Reown project ID for WalletConnect mobile and QR handoff.
# This is a browser-safe project identifier, never a wallet key or secret.
VITE_REOWN_PROJECT_ID=

# Optional public Supabase project values for the real social league.
# Never put an sb_secret_ key or legacy service_role JWT in a Vite variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
