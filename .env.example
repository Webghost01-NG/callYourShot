# Public DreamDEX venue identity. Obtain these from the event organizer.
VITE_DREAMDEX_OPERATOR_ID=
VITE_DREAMDEX_VENUE_ID=

# Optional public endpoint overrides. Official Shannon endpoints are used when omitted.
VITE_DREAMDEX_INDEXER_URL=
VITE_SOMNIA_WS_RPC_URL=

# Optional public Supabase project values for the real social league.
# Never put an sb_secret_ key or legacy service_role JWT in a Vite variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
