{
  "name": "call-your-shot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A social prediction league powered by DreamDEX Event Contracts.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "check:live": "tsx scripts/check-live-core.ts",
    "check:profile": "tsx scripts/check-profile.ts",
    "dev": "vite",
    "test": "node --import tsx --test tests/**/*.test.ts && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:dreamdex": "node scripts/dreamdex-validation-server.mjs"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "0.29.0",
    "@supabase/supabase-js": "2.115.0",
    "@tanstack/react-query": "5.102.8",
    "@walletconnect/ethereum-provider": "2.24.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.56.3",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "axios": "1.20.0"
  }
}
